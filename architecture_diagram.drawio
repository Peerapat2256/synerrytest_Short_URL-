        </mxCell>

        <!-- Redirect Service -->
        <mxCell id="svc_redirect" value="&lt;b&gt;2. Redirect Service&lt;/b&gt;&lt;br&gt;(redirect.service.ts)&lt;br&gt;ค้นหารหัสย่อ / เช็ควันหมดอายุ / 302" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" vertex="1" parent="ms_group">
          <mxGeometry x="20" y="165" width="200" height="85" as="geometry" />
        </mxCell>

        <!-- Analytics Service -->
        <mxCell id="svc_analytics" value="&lt;b&gt;3. Analytics Service&lt;/b&gt;&lt;br&gt;(analytics.service.ts)&lt;br&gt;นับจำนวนคลิก / บันทึก Click Logs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" vertex="1" parent="ms_group">
