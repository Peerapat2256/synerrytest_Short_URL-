<mxfile host="app.diagrams.net" agent="Mozilla/5.0">
  <diagram id="Microservice_Architecture" name="Microservice Architecture Diagram">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="arch_title" value="Microservice &amp; Layered Architecture Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="250" y="30" width="670" height="40" as="geometry" />
        </mxCell>

        <!-- Client Layer -->
        <mxCell id="client_box" value="&lt;b&gt;Client Layer (Frontend)&lt;/b&gt;&lt;br&gt;Web Browser / Mobile&lt;br&gt;(Vue 3 / Nuxt App)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="170" height="90" as="geometry" />
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="gateway_box" value="&lt;b&gt;API Gateway &amp;amp; Router&lt;/b&gt;&lt;br&gt;(Controller Layer)&lt;br&gt;&lt;br&gt;• POST /api/shorten&lt;br&gt;• GET /api/urls&lt;br&gt;• DELETE /api/urls/:id&lt;br&gt;• GET /api/urls/:id/logs&lt;br&gt;• GET /:code (302 Redirect)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="205" width="190" height="180" as="geometry" />
        </mxCell>

        <!-- Microservices Container -->
        <mxCell id="ms_group" value="Microservices Layer (Domain Services)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;swimlaneFillColor=#fafafa;strokeColor=#000000;strokeWidth=1.5;startSize=30;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="240" height="390" as="geometry" />
        </mxCell>

        <!-- Shortener Service -->
        <mxCell id="svc_shortener" value="&lt;b&gt;1. Shortener Service&lt;/b&gt;&lt;br&gt;(shortener.service.ts)&lt;br&gt;สร้างลิงก์สั้น / QR Code / จัดการลิงก์" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" vertex="1" parent="ms_group">
